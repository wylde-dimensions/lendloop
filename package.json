{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n next,convex -c green,magenta \"next dev -H localhost\" \"convex dev\"",
    "dev:next": "next dev -H localhost",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start -H localhost",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:signatures": "node scripts/check-signatures.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check": "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run test \u0026\u0026 npm run check:workflows",
    "make-admin": "node scripts/make-admin.mjs",
    "format": "prettier --write .",
    "seed": "convex run seed:demo",
    "n8n:export": "node scripts/export-workflows.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "stack:up": "docker compose -f docker/compose.yml up -d --wait",
    "stack:down": "docker compose -f docker/compose.yml down",
    "stack:logs": "docker compose -f docker/compose.yml logs -f --tail=100",
    "stack:destroy": "node scripts/teardown.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.8",
    "@convex-dev/rate-limiter": "^0.4.3",
    "convex": "^1.51.0",
    "convex-helpers": "^0.1.136",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^6.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.7",
    "convex-test": "^0.0.75",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "standardwebhooks": "^1.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
