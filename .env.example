# LendLoop has two env files, both git-ignored and both written by `npm run setup`:
# docker/.env and .env.local. This file documents every variable; nothing here is
# a real value.
#
# ─── docker/.env  (read by docker compose only; local secrets) ───────────────────
# Generated with crypto-random values. Single-quoted so compose treats `$` literally.
N8N_ENCRYPTION_KEY=''               # encrypts n8n credentials at rest
N8N_RUNNERS_AUTH_TOKEN=''           # n8n ↔ task runner shared token
CONVEX_INSTANCE_SECRET=''           # self-hosted Convex instance secret (derives admin keys)
LENDLOOP_CONVEX_TO_N8N_SECRET=''    # signs Convex → n8n webhooks (also set in Convex env)
LENDLOOP_N8N_TO_CONVEX_SECRET=''    # signs n8n → Convex calls (also set in Convex env)
N8N_OWNER_PASSWORD=''               # local n8n login, printed by setup
N8N_OWNER_PASSWORD_HASH=''          # bcrypt hash n8n reads (it never sees the plain password)
# Optional overrides:
# LENDLOOP_TIMEZONE=UTC             # what "today"/"overdue" mean; also n8n's schedule zone
# N8N_OWNER_EMAIL=owner@lendloop.example
# LENDLOOP_OPS_EMAIL=ops@lendloop.example   # where the n8n error workflow sends alerts
# Image versions are pinned by digest in docker/compose.yml, not here.
#
# ─── .env.local  (read by Next.js and the Convex CLI) ──────────────────────────
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=        # generated from the backend by setup
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...   # node scripts/set-clerk-keys.mjs publishable <key>
# CLERK_SECRET_KEY=sk_test_...                    # node scripts/set-clerk-keys.mjs secret <key>
# CLERK_FRONTEND_API_URL=              # derived from the publishable key by setup
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
#
# ─── Convex deployment env (set by setup via `npx convex env set`) ─────────────
# Declared and typed in convex/convex.config.ts; a push fails if a required one is missing.
# CLERK_FRONTEND_API_URL               # required: issuer Convex accepts tokens from
# LENDLOOP_APP_URL=http://localhost:3000
# LENDLOOP_TIMEZONE=UTC
# N8N_LOAN_EVENTS_WEBHOOK_URL=http://n8n:5678/webhook/lendloop/loan-events
# LENDLOOP_CONVEX_TO_N8N_SECRET / LENDLOOP_N8N_TO_CONVEX_SECRET   # same values as in docker/.env
# LENDLOOP_N8N_TO_CONVEX_SECRET_PREVIOUS                          # optional, during a key rotation
